# Copy to .env and fill in. .env is gitignored.
# A real environment variable takes precedence over this file.

# Mapbox public token for the demo map (https://account.mapbox.com/access-tokens).
# Restrict it by URL in the Mapbox dashboard: a pk. token reaches the browser.
MAPBOX_TOKEN=pk.your_token_here
MAPBOX_STYLE=mapbox://styles/mapbox/standard
